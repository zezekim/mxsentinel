# MX Sentinel cPanel plugin configuration.
# Installed to /etc/mxsentinel/plugin.conf  (must be root-owned, mode 0600).
#
# Read ONLY by root processes: the broker daemon (mxsentinel-plugin serve) and the WHM
# admin CGI. It holds the API token, so it must never be readable by cPanel users.

# Base URL of your MX Sentinel apid (no trailing slash).
api_base = https://api.mxsentinel.example.com

# A tenant API token (mxs_...). READ + RELAY scope is sufficient: `relay` covers the relay's
# SMTP submission user (POST /v1/smtp-users), which the WHM installer provisions. Normally
# install.sh writes this line for you — given an enrollment token (--enroll-token, a
# `provision`-scoped key) it mints this server its own read+relay key, named cpanel-<fqdn>.
# To mint one by hand instead:
#   mxctl apikey create --tenant <slug> --scopes read,relay --name cpanel-<fqdn>
# An older ADMIN-scope token still works (admin satisfies every scope check).
token = mxs_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verify the apid TLS certificate. Set to false only for an internal CA / self-signed
# endpoint you control.
verify_ssl = true

# Unix socket the broker listens on and the CGI connects to. The default matches the
# systemd RuntimeDirectory. Change only if you also change the unit + wrappers.
socket_path = /run/mxsentinel-plugin/api.sock
