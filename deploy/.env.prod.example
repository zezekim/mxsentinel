# MX Sentinel — production secrets for the prod compose overlay.
# Copy to deploy/.env and fill with STRONG, UNIQUE values. NEVER commit deploy/.env.
#
#   cp deploy/.env.prod.example deploy/.env   # then edit
#   docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.prod.yml \
#     --profile app --env-file deploy/.env up -d --build
#
# Tip: generate secrets with `openssl rand -hex 32`.

# Public domain (A record -> this VPS) + ACME email for automatic Let's Encrypt TLS.
MXS_DOMAIN=mxsentinel.example.com
MXS_ACME_EMAIL=ops@example.com

# Optional: additional hostnames the same dashboard/API answers on, space separated
# (e.g. a white-label domain). Each needs its own A record pointing at this VPS; Caddy
# issues a separate cert per hostname. Leave empty for a single-domain install.
MXS_EXTRA_DOMAINS=

# Viewer-role white-labelling. Any hostname under these suffixes is rewritten to a stable
# alias (relay-01.<base>, relay-02.<base>, …) in every API response served to a viewer, so
# a viewer on the white-label domain cannot tell who operates the relay. Comma separated;
# leave empty to disable. MXS_VIEWER_MASK_BASE is the domain aliases are minted under.
MXS_VIEWER_MASK_DOMAINS=
MXS_VIEWER_MASK_BASE=

# PostgreSQL (system of record)
PG_USER=mxsentinel
PG_PASSWORD=CHANGE-ME-strong-password
PG_DB=mxsentinel

# ClickHouse (telemetry) — default user, just the database name
CH_DB=mxsentinel

# MinIO / object storage (raw DMARC, forensic blobs)
MINIO_ROOT_USER=mxsentinel
MINIO_ROOT_PASSWORD=CHANGE-ME-strong-password
MINIO_BUCKET=mxsentinel

# AI reasoning layer (optional). Point at your Ollama/vLLM endpoint. On Linux, host
# Ollama may need an extra_hosts mapping or the host IP instead of host.docker.internal.
# On an 8GB box a ~3B model fits alongside ClickHouse; the 8B model is tight.
MXS_AI_ENDPOINT=http://host.docker.internal:11434/v1
MXS_AI_MODEL=llama3.2:3b

# Relay-on-box (the "relay" profile): telemetryd tails the Postfix maillog.
# See docs/deploy-relay.md.
RELAY_NODE_IP=
MAILLOG_PATH=/var/log/mail.log
MXS_TELEMETRY_HASHKEY=CHANGE-ME-random-hex

MXS_LOGLEVEL=info
