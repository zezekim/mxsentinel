# MX Sentinel auto-update overrides (optional).
# Installed by deploy/install.sh to /etc/mxsentinel/update.env and read by the
# mxsentinel-update.service unit. Uncomment/edit as needed, then:
#   sudo systemctl restart mxsentinel-update.timer

# Git branch the VPS tracks. CI advances this only after build+vet+test+typecheck pass.
#MXS_UPDATE_BRANCH=release

# Space-separated compose profiles to (re)deploy. Use "app relay" on a box that also runs
# the Postfix relay + telemetryd; "app" on an app-only node.
#MXS_UPDATE_PROFILES=app

# Readiness endpoint the updater polls before declaring a deploy healthy (rolls back if not).
#MXS_UPDATE_HEALTH_URL=http://127.0.0.1:9090/healthz
#MXS_UPDATE_HEALTH_TRIES=30
#MXS_UPDATE_HEALTH_WAIT=5

# Optional Slack-compatible webhook for deploy success/failure notifications.
#MXS_UPDATE_ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
