# Example environment overrides. Copy to .env and source it, or export selectively.
# Mapping: MXS_<SEGMENT>_<SEGMENT> -> dotted config key (segments are single words).
# Env values override the YAML config and the built-in defaults.

# MXS_CONFIG=deploy/config/mxsentinel.example.yaml
# MXS_LOGLEVEL=debug

# MXS_POSTGRES_DSN=postgres://mxsentinel:mxsentinel@localhost:5432/mxsentinel?sslmode=disable
# MXS_POSTGRES_MAXCONNS=10

# MXS_CLICKHOUSE_ADDR=localhost:9000
# MXS_CLICKHOUSE_DATABASE=mxsentinel
# MXS_CLICKHOUSE_USERNAME=default
# MXS_CLICKHOUSE_PASSWORD=

# MXS_REDIS_ADDR=localhost:6379
# MXS_REDIS_DB=0

# MXS_NATS_URL=nats://localhost:4222

# MXS_OBJECTSTORE_ENDPOINT=localhost:9001
# MXS_OBJECTSTORE_BUCKET=mxsentinel
# MXS_OBJECTSTORE_ACCESSKEY=minioadmin
# MXS_OBJECTSTORE_SECRETKEY=minioadmin
# MXS_OBJECTSTORE_USESSL=false

# AI reasoning layer (local OpenAI-compatible LLM)
# MXS_AI_ENDPOINT=http://localhost:11434/v1
# MXS_AI_MODEL=llama3
# MXS_AI_APIKEY=
# MXS_AI_TIMEOUTSECS=60

# ── Outbound security suite (see docs/deploy-relay.md §12) ──────────────────────

# rbld — RBL/DNSBL self-monitoring of the relay's egress IPs + auto-pull.
# RELAY_EGRESS_IPS is the comma-separated outbound IP pool to monitor; both rbld AND apid
# (for GET /v1/rbl/status) read it. Falls back to RELAY_NODE_IP (single IP) when unset.
# RELAY_EGRESS_IPS=203.0.113.11,203.0.113.12,203.0.113.13
# RELAY_NODE_IP=203.0.113.11
# RBL_ZONES=zen.spamhaus.org,b.barracudacentral.org,bl.spamcop.net,dnsbl.sorbs.net,cbl.abuseat.org
# RBL_INTERVAL=15m
# RBL_LOOKUP_TIMEOUT=5s
# RBL_HEALTHY_IPS_DIR=../rbl-state   # host dir bind-mounted to /var/lib/mxsentinel in rbld

# anomalyd — send-volume anomaly detection (per sending domain).
# ANOMALY_FACTOR=5.0          # trip when current-hour volume > baseline*FACTOR
# ANOMALY_MIN_ABS=100         # ...and over this absolute count
# ANOMALY_MIN_SAMPLES=6       # completed hours of baseline before a domain can trip

# fbld — feedback-loop (ARF) ingestion + Gmail Postmaster reputation.
# GOOGLE_POSTMASTER_TOKEN=    # operator-supplied bearer token; unset = Postmaster poll skipped
# FBL_COMPLAINT_THRESHOLD=10  # 24h complaints for a domain before an incident opens

# authwatchd — SASL credential-compromise detection.
# AUTHWATCH_AUTOLOCK=false    # opt-in: lock the SASL credential on a trip. DANGER on a shared
#                             # relay — one credential serves every client (leave false there).

# ── Webmail autologin (see docs/webmail-autologin.md) ───────────────────────────

# One-click "Webmail" on the SMTP Users page: the dashboard mints a single-use token and
# Roundcube's mxs_autologin plugin redeems it to log that user straight into their mailbox.
# Disabled unless BOTH BASEURL and PLUGINSECRET are set.
#
# Prerequisites: SMTP users need real IMAP mailboxes — run
#   sudo bash deploy/install.sh --wire-webmail
# and install deploy/roundcube/mxs_autologin into Roundcube.
#
# MXS_ENCRYPTION_KEY must be set: apid stores an AES-256-GCM sealed copy of each SMTP
# password (smtp_users.password_enc) because IMAP cannot authenticate against a bcrypt
# hash. Without a key nothing reversible is stored and webmail stays unavailable. Existing
# users get their sealed copy on their next password reset.
# MXS_WEBMAIL_BASEURL=https://sentinel.example.com/roundcube
# MXS_WEBMAIL_PLUGINSECRET=          # openssl rand -hex 32; must equal the plugin's mxs_autologin_secret
# MXS_WEBMAIL_IMAPHOST=host.docker.internal  # as resolved from ROUNDCUBE's network
# MXS_WEBMAIL_IMAPPORT=143
# MXS_WEBMAIL_IMAPTLS=starttls       # starttls (tls://, 143) | tls (ssl://, 993) | none
# MXS_WEBMAIL_TOKENTTL=60            # seconds a minted autologin token stays redeemable

# Relay-side webmail provisioning (read by deploy/install.sh, not by the services):
# WEBMAIL=1                          # provision Dovecot IMAP + maildir store on the relay
# WEBMAIL_IMAP_LISTEN=127.0.0.1,172.17.0.1  # IMAP bind addresses (host-local only)
# WEBMAIL_DOMAINS=                   # OPT-IN: domains this host should DELIVER (not relay).
#                                    # Empty = mail routing untouched and mailboxes stay empty.
